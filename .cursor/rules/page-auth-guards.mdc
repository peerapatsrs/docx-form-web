description: Every protected page and API must hard-block direct URL access — proxy + server layout + API gate
globs: src/app/**/*.{ts,tsx},src/proxy.ts,src/lib/server-auth.ts,src/server/api.ts,src/components/admin/**
alwaysApply: true
