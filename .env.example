# Public site origin (canonical / Open Graph / JSON-LD / sitemap).
# Prefer APP_BASE_URL in production; falls back to NEXT_PUBLIC_APP_URL, BETTER_AUTH_URL,
# then RENDER_EXTERNAL_URL (set automatically on Render).
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Better Auth session origin. When set, this wins over APP_BASE_URL for auth cookies.
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated extra hostnames allowed for HTTPS-upgrade checks
# (redirect targets still use APP_BASE_URL — never the raw Host header).
# APP_ALLOWED_HOSTS=docx-form-web.onrender.com
# UI version label: short git SHA from the first set env below (fallback: package.json).
# RENDER_GIT_COMMIT / SOURCE_COMMIT / GIT_SHA are checked automatically.
# Optional: APP_BUILD_COMMIT_ENV=RENDER_GIT_COMMIT
# Optional: APP_BUILD_SHA=abc1234

# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Central Keycloak OIDC SSO (REQUIRED — only login) ---
# Realms: tps18-dev / tps18-sit / tps18-uat / tps18-prod under https://auth.tps18.space
# — never hardcode the realm in app code; set OIDC_ISSUER per env.
# Missing any of these → /login shows "SSO not configured" (no fallback login).
# Redirect URI:      {APP_BASE_URL}/api/auth/oidc/callback
# Post-logout URI:   {APP_BASE_URL}/logged-out
# See docs/AUTH-OIDC-SSO.md
OIDC_ISSUER=https://auth.tps18.space/realms/tps18-dev
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional override for Keycloak passkey management (account console).
# Default when unset: ${OIDC_ISSUER}/account/#/account-security/signing-in
# OIDC_PASSKEY_MANAGE_URL=

# PostgreSQL (Better Auth + identities). Docker Compose default:
DATABASE_URL=postgres://docx:docx@127.0.0.1:5432/docx_form

# Comma-separated emails promoted to role=superadmin (OIDC-verified match)
SUPERADMIN_EMAILS=peerapat.srs@gmail.com

# --- AI provider API URLs (public; safe to commit in example) ---
AI_GEMINI_API_BASE=https://generativelanguage.googleapis.com
AI_ANTHROPIC_API_BASE=https://api.anthropic.com
AI_PROVIDER_GOOGLE_DOCS_URL=https://aistudio.google.com/apikey
AI_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_OPENAI_DOCS_URL=https://platform.openai.com/api-keys
AI_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_PROVIDER_ANTHROPIC_DOCS_URL=https://console.anthropic.com/settings/keys
AI_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_OPENROUTER_DOCS_URL=https://openrouter.ai/keys
AI_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_PROVIDER_DEEPSEEK_DOCS_URL=https://platform.deepseek.com/api_keys
AI_PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_GROQ_DOCS_URL=https://console.groq.com/keys
AI_PROVIDER_XAI_BASE_URL=https://api.x.ai/v1
AI_PROVIDER_XAI_DOCS_URL=https://console.x.ai/
AI_PROVIDER_MISTRAL_BASE_URL=https://api.mistral.ai/v1
AI_PROVIDER_MISTRAL_DOCS_URL=https://console.mistral.ai/api-keys
# Cursor form AI uses @cursor/sdk Cloud Agents (no-repo). BYOK crsr_… keys are
# sent per request from the browser — do not put user keys in CURSOR_API_KEY.
# When DOCX_FORM_BYOK_ONLY=0, optional shared Cursor key for users without BYOK:
# DOCX_FORM_CURSOR_API_KEY=
AI_PROVIDER_CURSOR_BASE_URL=https://api.cursor.com/v1
AI_PROVIDER_CURSOR_DOCS_URL=https://cursor.com/docs/sdk/typescript
# Cloud Agent waits are not capped by the app (long runs use async AI jobs + polling).
# Optional: encrypt user-synced AI keys (falls back to BETTER_AUTH_SECRET)
# AI_VAULT_SECRET=
