# App URL (must match the browser origin — used for OAuth callbacks + passkeys)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# PostgreSQL (Better Auth). Docker Compose default:
# DATABASE_URL=postgres://docx:docx@127.0.0.1:5432/docx_form
DATABASE_URL=postgres://docx:docx@127.0.0.1:5432/docx_form

# Comma-separated emails that always get role=superadmin (boot + new signups)
SUPERADMIN_EMAILS=peerapat.srs@gmail.com

# Local user picker + Run Local auto sign-in (no real OAuth).
# Auto-on in development; Docker Compose defaults to 1. Set 0 to disable.
# DEV_AUTH=1
# Preferred account when auto-signing in (defaults to first SUPERADMIN_EMAILS).
# DEV_AUTH_DEFAULT_EMAIL=peerapat.srs@gmail.com

# --- OAuth (only providers with BOTH id + secret are shown) ---
# Google (required for primary login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional providers — leave blank to hide
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# When 1, unauthenticated users are redirected to /login for the main app
# AUTH_REQUIRED=0

# --- AI provider API URLs (public; safe to commit in example) ---
AI_GEMINI_API_BASE=https://generativelanguage.googleapis.com
AI_ANTHROPIC_API_BASE=https://api.anthropic.com
AI_PROVIDER_GOOGLE_DOCS_URL=https://aistudio.google.com/apikey
AI_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_OPENAI_DOCS_URL=https://platform.openai.com/api-keys
AI_PROVIDER_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_PROVIDER_ANTHROPIC_DOCS_URL=https://console.anthropic.com/settings/keys
AI_PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_OPENROUTER_DOCS_URL=https://openrouter.ai/keys
AI_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_PROVIDER_DEEPSEEK_DOCS_URL=https://platform.deepseek.com/api_keys
AI_PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_GROQ_DOCS_URL=https://console.groq.com/keys
AI_PROVIDER_XAI_BASE_URL=https://api.x.ai/v1
AI_PROVIDER_XAI_DOCS_URL=https://console.x.ai/
AI_PROVIDER_MISTRAL_BASE_URL=https://api.mistral.ai/v1
AI_PROVIDER_MISTRAL_DOCS_URL=https://console.mistral.ai/api-keys
# Cursor form AI uses @cursor/sdk Cloud Agents (no-repo). BYOK crsr_… keys are
# sent per request from the browser — do not put user keys in CURSOR_API_KEY.
AI_PROVIDER_CURSOR_BASE_URL=https://api.cursor.com/v1
AI_PROVIDER_CURSOR_DOCS_URL=https://cursor.com/docs/sdk/typescript
# Optional cloud-agent wait timeout (ms). Default 180000.
# CURSOR_AGENT_TIMEOUT_MS=180000
# Optional: encrypt user-synced AI keys (falls back to BETTER_AUTH_SECRET)
# AI_VAULT_SECRET=
