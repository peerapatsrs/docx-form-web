{
  "name": "docx-form-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "minify:public": "node scripts/minify-public.mjs",
    "build": "next build",
    "build:prod": "npm run minify:public && next build",
    "start": "next start",
    "lint": "eslint",
    "test:smoke": "node scripts/smoke-test.mjs",
    "auth:migrate": "tsx --env-file=.env.local scripts/auth-migrate.ts",
    "test:unit": "tsx scripts/public-origin-unit-test.mjs && tsx scripts/qa-unit-test.mjs && tsx scripts/ui-labels-unit-test.mjs && tsx scripts/dev-auth-auto-login-unit-test.mjs && tsx scripts/dev-auth-unit-test.mjs && tsx scripts/cache-and-auth-url-unit-test.mjs",
    "test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from test",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "author": {
    "name": "Peerapat Surasing",
    "email": "peerapat.srs@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peerapatsrs/docx-form-web.git"
  },
  "license": "MIT",
  "dependencies": {
    "@better-auth/passkey": "^1.7.14",
    "@cursor/sdk": "^1.2.0",
    "better-auth": "^1.7.14",
    "easy-template-x": "^8.0.0",
    "hono": "^4.13.14",
    "jszip": "^3.10.2",
    "next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "picomatch": "^4.0.7"
  }
}
